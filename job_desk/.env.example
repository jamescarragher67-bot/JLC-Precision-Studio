# Template only. Leave the values blank here and never commit real keys.
# This app reads keys from real environment variables. It does not load .env files,
# so export these in your shell (or your OS's environment settings) if you need them.
# Nothing in this build calls a model, so the keys are not needed yet.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional path overrides. Blank means the defaults inside job_desk/
# (data/ for the database, jobs/ for job folders and events.log).
JOB_DESK_DATA_DIR=
JOB_DESK_JOBS_ROOT=
